{
  "name": "@oisamitech/redis",
  "version": "1.3.0",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "rollup -c rollup.config.mjs",
    "prepare": "git config core.hooksPath .hooks",
    "prepublishOnly": "npm run build",
    "standard:fix": "standard --fix"
  },
  "engines": {
    "node": "^18 || >=20"
  },
  "keywords": [
    "redis",
    "storage"
  ],
  "author": "Pedro Assis <pedro.assis@samisaude.com>",
  "license": "MIT",
  "description": "A battle-tested Redis client for Node.js applications.",
  "devDependencies": {
    "@commitlint/cli": "^19.5.0",
    "@commitlint/config-conventional": "^19.5.0",
    "@rollup/plugin-commonjs": "^28.0.0",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^15.3.0",
    "lint-staged": "^15.2.10",
    "rollup": "^4.22.5",
    "standard": "^17.1.2"
  },
  "dependencies": {
    "ioredis": "^5.4.1",
    "pino": "^9.5.0",
    "pino-pretty": "^11.3.0"
  },
  "lint-staged": {
    "src/**/*.js": "standard"
  },
  "repository": {
    "url": "git+https://github.com/oisamitech/redis.git"
  },
  "bugs": {
    "url": "https://github.com/oisamitech/redis/issues"
  },
  "homepage": "https://github.com/oisamitech/redis#readme"
}

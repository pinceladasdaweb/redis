{
  "name": "@pinceladasdaweb/redis",
  "version": "1.0.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "rollup -c rollup.config.mjs",
    "prepare": "git config core.hooksPath .hooks",
    "prepublishOnly": "npm run build",
    "standard:fix": "standard --fix",
    "test": "node --test 'tests/**/*.test.js'",
    "test:coverage": "node --test --experimental-test-coverage 'tests/**/*.test.js'",
    "test:integration": "REDIS_INTEGRATION=1 node --test 'tests/**/*.test.js'"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "redis",
    "ioredis",
    "cache",
    "caching",
    "client",
    "storage",
    "key-value",
    "streams",
    "resilience",
    "reconnection",
    "health-check",
    "json"
  ],
  "author": "Pedro Rogério <pinceladasdaweb@hotmail.com>",
  "license": "MIT",
  "description": "A resilient Redis client for Node.js built on ioredis, with automatic reconnection, health checks and JSON helpers.",
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "lint-staged": "^17.2.0",
    "rollup": "^4.62.2",
    "standard": "^17.1.2",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "ioredis": "^5.11.1"
  },
  "lint-staged": {
    "src/**/*.js": "standard",
    "tests/**/*.js": "standard"
  },
  "repository": {
    "url": "git+https://github.com/pinceladasdaweb/redis.git"
  },
  "bugs": {
    "url": "https://github.com/pinceladasdaweb/redis/issues"
  },
  "homepage": "https://github.com/pinceladasdaweb/redis#readme"
}

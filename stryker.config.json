{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "npm",
  "testRunner": "tap",
  "tap": {
    "testFiles": [
      "tests/*.test.js"
    ],
    "nodeArgs": [
      "--test",
      "--test-reporter=tap",
      "--experimental-test-isolation=none",
      "--test-timeout=3000"
    ]
  },
  "mutate": [
    "src/**/*.js"
  ],
  "coverageAnalysis": "all",
  "reporters": [
    "json",
    "html",
    "progress"
  ],
  "htmlReporter": {
    "fileName": "reports/mutation/index.html"
  },
  "clearTextReporter": {
    "maxTestsToLog": 1
  },
  "concurrency": 6,
  "timeoutMS": 20000,
  "thresholds": {
    "high": 90,
    "low": 80,
    "break": null
  },
  "jsonReporter": {
    "fileName": "reports/mutation/mutation.json"
  },
  "appendPlugins": [
    "./stryker-mutation-policy.js"
  ],
  "ignorers": [
    "message-text"
  ]
}
